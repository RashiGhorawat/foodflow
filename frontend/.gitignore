```gitignore
# C++ build output
build/
cmake-build-*/

# React dependencies and build output
node_modules/
frontend/node_modules/
frontend/dist/

# Environment variables and secrets
.env
.env.*

# Allow example environment files
!.env.example

# macOS
.DS_Store

# IDE
.vscode/

# Compiled files
*.o
*.a
*.out
```